{
    "name": "langsys/langsys-php-symfony",
    "description": "Symfony integration for the Langsys translation SDK — bundle, t() Twig function, locale-detection subscriber, and PSR-6 catalog caching over langsys/langsys-php.",
    "keywords": ["i18n", "l10n", "symfony", "twig", "localization", "internationalization", "translation", "langsys", "sdk"],
    "homepage": "https://github.com/langsys/langsys-php-symfony",
    "license": "MIT",
    "authors": [
        {
            "name": "Langsys"
        }
    ],
    "require": {
        "php": "^8.1",
        "langsys/langsys-php": "^1.0",
        "psr/cache": "^2.0 || ^3.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/cache": "^6.4 || ^7.0",
        "twig/twig": "^3.8"
    },
    "suggest": {
                "twig/twig": "The t() Twig function and |t filter",
        "symfony/twig-bundle": "Auto-registers the Twig extension"
    },
    "autoload": {
        "psr-4": {
            "Langsys\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Langsys\\Symfony\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
